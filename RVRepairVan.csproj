<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared release hardening: strip Release debug info + assembly identity, cuts AV false positives (see Workspace/build/Hardening.props). -->
  <Import Project="$(MSBuildThisFileDirectory)../Workspace/build/Hardening.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/Hardening.props')" />
  <Import Project="$(MSBuildThisFileDirectory)Workspace/build/Hardening.props" Condition="Exists('$(MSBuildThisFileDirectory)Workspace/build/Hardening.props')" />

  <!-- Optional Snitch profiler in Debug builds (no-op when the Snitch host is absent, e.g. CI, which only
       checks out Workspace/lib and not Workspace/build). -->
  <Import Project="$(MSBuildThisFileDirectory)../Workspace/build/Snitch.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/Snitch.props')" />

  <!--
    RVRepairVan - MelonLoader mod for Schedule I.
    Dual-backend capable (extends the Mimesis-InventoryExpansion template):
      net6.0          => IL2CPP backend  (Backend=il2cpp, refs from Workspace/lib/il2cpp)
      netstandard2.1  => Mono   backend  (Backend=mono,   refs from Workspace/lib/mono)
    Currently builds IL2CPP only; the netstandard2.1 target is enabled once the Mono libs exist.
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <!-- Enable both once Mono libs are captured (Steam 'alternate' branch):
         <TargetFrameworks>net6.0;netstandard2.1</TargetFrameworks> -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <RootNamespace>RVRepairVan</RootNamespace>
    <AssemblyName>RVRepairVan</AssemblyName>
    <NeutralLanguage>en-US</NeutralLanguage>
    <!-- NEVER bumped. The release version comes from the tag: CI builds with -p:Version=X.Y.Z, which is a
         global MSBuild property and therefore cannot be overwritten from here. A local build without one
         says 0.0.0-dev, which is exactly what it is. AssemblyVersion and FileVersion are left to the SDK -
         pinning them by hand is how they drift out of Version.
         Rules: Workspace/docs/RELEASE-PROCESS.md, section "Versioning". -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <!-- Suppress MSB3277/MSB3245 noise from il2cpp interop transitive refs -->
    <NoWarn>$(NoWarn);MSB3277;MSB3245</NoWarn>

    <!-- Workspace lib roots (mirrors Mimesis ../Workspace/lib) -->
    <WorkspaceLibPath Condition="'$(WorkspaceLibPath)' == ''">$(MSBuildThisFileDirectory)../Workspace/lib</WorkspaceLibPath>
  </PropertyGroup>

  <!-- Backend selection derived from the active TargetFramework -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <Backend>il2cpp</Backend>
    <DefineConstants>$(DefineConstants);IL2CPP</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Backend>mono</Backend>
    <DefineConstants>$(DefineConstants);MONO</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <GameManagedPath>$(WorkspaceLibPath)/$(Backend)/game</GameManagedPath>
    <MelonLoaderPath>$(WorkspaceLibPath)/$(Backend)/melonloader</MelonLoaderPath>
  </PropertyGroup>

  <!-- Backend-specific GlobalUsings: keep only the active backend's file -->
  <ItemGroup>
    <Compile Remove="Compat/GlobalUsings.Il2Cpp.cs" Condition="'$(Backend)' != 'il2cpp'" />
    <Compile Remove="Compat/GlobalUsings.Mono.cs" Condition="'$(Backend)' != 'mono'" />
  </ItemGroup>

  <!-- CI checks out the shared Workspace repo as a SUBFOLDER of this project, so the SDK's default **/*.cs glob
       would sweep in Workspace/ui, Workspace/build, etc. (uGUI design-system source this mod does not use).
       RVRepairVan compiles only its own source - exclude everything under Workspace. No-op locally, where
       Workspace is a sibling folder. Anything actually needed (e.g. the Snitch shim) is linked explicitly via props. -->
  <ItemGroup>
    <Compile Remove="Workspace/**/*.cs" />
  </ItemGroup>

  <!-- Generates DooDesch.ModVersion.Current from this project's own version property, so MelonInfo carries the
       released version and cannot drift out of it. MUST come after the Workspace Remove so CI keeps the file. -->
  <Import Project="$(MSBuildThisFileDirectory)../Workspace/build/ModVersion.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/ModVersion.props')" />
  <Import Project="$(MSBuildThisFileDirectory)Workspace/build/ModVersion.props" Condition="Exists('$(MSBuildThisFileDirectory)Workspace/build/ModVersion.props')" />


  <!-- hash's shim: one file, no references, no hard dependency. It puts this mod's own console words into the
       game's command list so anything that lists commands can see them. Taken from the hash checkout beside this
       one when there is one, and from the workspace copy otherwise - CI checks out this repo alone.

       It has to come after the Compile Remove above: on CI the workspace repo is checked out INTO this one,
       so Workspace/**/*.cs matches the shim's own path and a Remove after the Include wins. -->
  <PropertyGroup>
    <HashShimPath Condition="Exists('$(MSBuildThisFileDirectory)../Hash/Hash.Api/HashCommands.cs')">$(MSBuildThisFileDirectory)../Hash/Hash.Api/HashCommands.cs</HashShimPath>
    <HashShimPath Condition="'$(HashShimPath)' == '' And Exists('$(WorkspaceLibPath)/hash-api/HashCommands.cs')">$(WorkspaceLibPath)/hash-api/HashCommands.cs</HashShimPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(HashShimPath)' != ''">
    <Compile Include="$(HashShimPath)" Link="Hash.Api/HashCommands.cs" />
  </ItemGroup>


  <!-- Shared "eyes close -> act -> open" transition primitive (DooDesch.Transition). Linked source, self-contained
       backend-gated; MUST come AFTER the Workspace Remove above so CI does not strip the included files.
       Resolved via $(WorkspaceLibPath)/.. so the SAME line works locally (Workspace = sibling folder) and in
       CI (Workspace = subfolder checkout, WorkspaceLibPath passed via /p:) - a plain ../Workspace path would
       silently skip the import in CI and fail the build with missing DooDesch.* types. -->
  <Import Project="$(WorkspaceLibPath)/../build/ScreenTransition.props" Condition="Exists('$(WorkspaceLibPath)/../build/ScreenTransition.props')" />

  <!-- Shared gettext-style localization (DooDesch.Localization.L10n). Linked source, internal class,
       backend-agnostic; same AFTER-the-Remove and path-resolution rules as above. -->
  <Import Project="$(WorkspaceLibPath)/../build/L10n.props" Condition="Exists('$(WorkspaceLibPath)/../build/L10n.props')" />
  <!-- Where a build is allowed to install: the test copy by default, and never a real game installation
       without saying so out loud. See Workspace/build/Deploy.props. -->
  <Import Project="$(MSBuildThisFileDirectory)../Workspace/build/Deploy.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/Deploy.props')" />
  <Import Project="$(MSBuildThisFileDirectory)Workspace/build/Deploy.props" Condition="Exists('$(MSBuildThisFileDirectory)Workspace/build/Deploy.props')" />

  <!-- Chassis seats the driver and the passenger in the cab, turns the steering wheel and runs horn, indicators and
       automatic headlights. A sibling checkout builds it; otherwise the DLL from the shared lib folder.
       ChassisProject points at another checkout, e.g. a Chassis worktree with an API change. -->
  <PropertyGroup>
    <ChassisProject Condition="'$(ChassisProject)' == ''">$(MSBuildThisFileDirectory)../Chassis/Chassis.csproj</ChassisProject>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(ChassisProject)')">
    <ProjectReference Include="$(ChassisProject)" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(ChassisProject)')">
    <Reference Include="Chassis">
      <HintPath>$(WorkspaceLibPath)/$(Backend)/chassis/Chassis.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Mod loader references (both backends) -->
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderPath)/MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderPath)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Managed Newtonsoft shipped with MelonLoader, the one S1API serialises saves with. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(MelonLoaderPath)/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- IL2CPP-only references -->
  <ItemGroup Condition="'$(Backend)' == 'il2cpp'">
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonLoaderPath)/Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameManagedPath)/Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(GameManagedPath)/Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedPath)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppScheduleOne.Core">
      <HintPath>$(GameManagedPath)/Il2CppScheduleOne.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppFishNet.Runtime">
      <HintPath>$(GameManagedPath)/Il2CppFishNet.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="S1API.Il2Cpp.MelonLoader">
      <HintPath>$(WorkspaceLibPath)/il2cpp/s1api/S1API.Il2Cpp.MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameManagedPath)/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameManagedPath)/UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- BoxCollider: the invisible slabs the crew NavMesh bake needs geometry from -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameManagedPath)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ScreenCapture: frame recorder of the debug drive clip -->
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(GameManagedPath)/UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- WheelCollider: drive diagnostics of the RV chassis -->
    <Reference Include="UnityEngine.VehiclesModule">
      <HintPath>$(GameManagedPath)/UnityEngine.VehiclesModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- NavMesh sampling: needed to tell whether the RV interior is walkable for employees -->
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(GameManagedPath)/UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- NavMeshSurface / runtime bake for the crew quarters (vanilla never bakes at runtime) -->
    <Reference Include="Unity.AI.Navigation">
      <HintPath>$(GameManagedPath)/Unity.AI.Navigation.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Bundled assets, embedded so they ship inside the DLL - no extra files. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\quest_icon.png">
      <LogicalName>RVRepairVan.quest_icon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\repair.wav">
      <LogicalName>RVRepairVan.repair.wav</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Condition="Exists('$(ModsDirectory)')"
          Command="cmd /c if exist &quot;$(ModsDirectory)&quot; copy /Y &quot;$(TargetPath)&quot; &quot;$(ModsDirectory)&quot;"
          ContinueOnError="true" />
  </Target>

</Project>
